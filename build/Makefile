	$(MAKE) $(MAKESILENT) -f CMakeFiles/image_processor.dir/build.make CMakeFiles/image_processor.dir/help.cpp.o
.PHONY : help.cpp.o

help.i: help.cpp.i
.PHONY : help.i

# target to preprocess a source file
help.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/image_processor.dir/build.make CMakeFiles/image_processor.dir/help.cpp.i
.PHONY : help.cpp.i

help.s: help.cpp.s
.PHONY : help.s

# target to generate assembly for a file
help.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/image_processor.dir/build.make CMakeFiles/image_processor.dir/help.cpp.s
.PHONY : help.cpp.s

image_processor.o: image_processor.cpp.o
.PHONY : image_processor.o

